# Base image
FROM rocker/tidyverse:4.5

# Bootstrap package installers
RUN Rscript -e " \
    install.packages(c('remotes', 'devtools')); \
    if (!require('BiocManager', quietly = TRUE)) \
        install.packages('BiocManager') \
"

# Install sesame from Bioconductor (R 4.5, unpatched)
RUN Rscript -e " \
    BiocManager::install('sesame', update = FALSE, ask = FALSE) \
"

# Copy analysis script and data into the container,
# preserving the same directory structure
COPY Scripts/methylmaster.R /Analysis/Scripts/sesame.R
COPY LabData/               /Analysis/LabData/

WORKDIR /analysis